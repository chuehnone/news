<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chinsheng.news-fetch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/chinsheng/Documents/Projects/news/news.py</string>
        <string>fetch</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/chinsheng/Documents/Projects/news</string>
    <!-- 每天 08:00 抓一次；Mac 當時在睡眠會於喚醒後補跑 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/chinsheng/Documents/Projects/news/fetch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/chinsheng/Documents/Projects/news/fetch.log</string>
</dict>
</plist>
